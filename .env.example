# Database — a plain SQLite file, zero config. Works out of the box for local
# dev and for any host with a persistent disk (a VPS, Railway, Render, Fly.io,
# Docker). Point this at a writable path; the app creates the file and its
# tables on first run. NOTE: this will NOT work on Vercel or other serverless
# hosts, whose filesystem is wiped between requests — deploy this app to a
# host with persistent storage instead (see README "Deploying").
DATABASE_PATH="./data/app.db"

# Session secret — any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-this-to-a-long-random-string"

# Owner admin login — used only the first time the database is seeded.
# Change the password from the admin panel after first login.
ADMIN_EMAIL="ravitools76@gmail.com"
ADMIN_PASSWORD="change-me-on-first-login"

# Shop contact details are plain constants in src/lib/siteConfig.ts, not env
# vars — edit that file if the phone number, email or address changes.

# Razorpay — leave blank to launch with the "Request a Call / Pay on Delivery" flow only.
# Add these once you have a Razorpay account (Naveen already has integration experience
# with this from the Mphasis project) and online checkout switches on automatically.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Image storage driver: "local" (default, stores under /public/uploads — fine for a VPS,
# Railway or Render with a persistent disk) or "cloudinary" (needed on Vercel, whose
# filesystem is not persistent across deploys).
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
